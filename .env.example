# Copy to .env and fill in these values.
PORT=3100
# The site's public address. Stripe sends members back here after paying.
PUBLIC_URL=http://localhost:3100

# The first admin account is created from these on start-up, if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# The hidden admin page lives at this path. Nothing links to it; use a hard-to-guess value.
VITE_ADMIN_PATH=/staff-change-me

# Stripe secret key. Use a test key (sk_test_...) until you are ready to take real payments.
STRIPE_SECRET_KEY=

# Set to 1 when hosted behind a single reverse proxy.
# TRUST_PROXY=1
